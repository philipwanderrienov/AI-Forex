# Copy to /etc/forex-intelligence/api.env with owner root and mode 0600.
# Quote values according to systemd EnvironmentFile syntax when needed.
ConnectionStrings__PostgreSql='Host=127.0.0.1;Port=5432;Database=forex_intelligence;Username=forex_app;Password=REPLACE_ME'
Jwt__SigningKey='REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES'
BootstrapUser__Username='admin'
BootstrapUser__PasswordHash='REPLACE_WITH_PBKDF2_SHA256_HASH'
BootstrapUser__Role='ADMIN'
BridgeAuthentication__ApiKey='REPLACE_WITH_THE_SHARED_BRIDGE_KEY'
